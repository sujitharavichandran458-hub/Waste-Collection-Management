@startuml
left to right direction

actor "Administrator" as Admin
actor "Collection Staff" as Staff

rectangle "EcoTrack - Waste Collection Management System" {

    usecase "View Dashboard" as UC1
    usecase "Manage Areas" as UC2
    usecase "Manage Vehicles" as UC3
    usecase "View Waste Collections" as UC4
    usecase "Add Waste Collection" as UC5
    usecase "Update Collection Status" as UC6
    usecase "View Reports" as UC7
    usecase "Analyze Waste Data" as UC8

}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8

Staff --> UC4
Staff --> UC5
Staff --> UC6

@enduml